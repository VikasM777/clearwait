# Application Settings
PROJECT_NAME="QuietHours API"
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (local dev): sqlite:///./quiethours.db
# For PostgreSQL (production, e.g. Render / Railway / Supabase):
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./quiethours.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://vikasm777.github.io,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500
